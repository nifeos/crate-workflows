#!/bin/sh
#
# script/lint: this repository's own gates. Runs offline (selftests, greps, shell checks) and is
# called by the selftest workflow's lint job, which installs the pinned actionlint first.
#
# What each section is for:
# - shell checks: every script here runs inside a caller's CI; a shell bug is nine repositories'
#   red at once.
# - selftests: the python helpers carry their own; a change to a gate without a test of the gate is
#   not done.
# - naming checks: the spelled-out words, unit symbols, American spelling, service-model names,
#   contract crates and question-shaped functions, run over the template's own Rust, so a word list
#   change that refuses the fixture fails here first; the abbreviations report runs there too.
# - scaffold: the files a crate repository copies name no other tree (nife, roadmap citations).
# - SHA pinning: the same grep nife runs. A floating `uses:` is a supply-chain hole in every caller
#   at once.
# - workflow shape: reusable workflows declare permissions; the lag check is the first job where a
#   stale pin should fail (helpers/workflow_shape.py); the budget lint holds the clock steps
#   (helpers/job_budget.py lint).
# - prose: em-dashes and the banned words nife's style refuses; a template that teaches by example
#   keeps the style.
# - actionlint: lints every file in .github/workflows and the caller templates in
#   scaffold/caller-workflows (placeholders filled). Required, like typos; the pinned version is in
#   helpers/install_actionlint.sh.

set -eu

cd "$(dirname "$0")/.."

fail() {
	echo "lint: $1" >&2
	exit 1
}

echo "==> shell checks"
scripts="script/lint script/record-ruling script/stranger-due script/stranger-recorded script/sync-labels helpers/*.sh"
shellcheck --severity=warning $scripts
for f in $scripts; do
	case "$(head -1 "$f")" in
	'#!/bin/sh') sh -n "$f" ;;
	esac
done
echo "ok"

echo "==> stranger-recorded gate"
# The release gate must fail on 'Last run: none' and pass on a dated line.
fixtures="$(mktemp -d)"
trap 'rm -rf "$fixtures"' EXIT
printf 'Last run: none\n' >"$fixtures/none.md"
printf 'Last run: 2026-11-01\n' >"$fixtures/dated.md"
printf 'prose only\n' >"$fixtures/absent.md"
script/stranger-recorded "$fixtures/dated.md" >/dev/null || fail "stranger-recorded refused a dated line"
script/stranger-recorded "$fixtures/scaffold-copy.md" >/dev/null 2>&1 && fail "stranger-recorded passed a missing file"
for bad in none absent; do
	if script/stranger-recorded "$fixtures/$bad.md" >/dev/null 2>&1; then
		fail "stranger-recorded passed $bad"
	fi
done
if script/stranger-recorded scaffold/docs/stranger-test.md >/dev/null 2>&1; then
	fail "the scaffold's stranger record must start at none, and the gate must refuse it"
fi
echo "ok"

echo "==> the semver rule's trigger filter"
# label.yml repeats helpers/semver-rule.sh's filter to skip the install; the selftest proves the
# helper's copy, so the two must stay the same text.
filter="grep -qE '(\\.rs|(^|/)Cargo\\.toml)\$'"
for f in .github/workflows/label.yml helpers/semver-rule.sh; do
	grep -qF "$filter" "$f" || fail "$f does not carry the semver trigger filter $filter"
done
echo "ok"

echo "==> python selftests"
py="$(command -v python3)"
if ! "$py" -c 'import tomllib' 2>/dev/null; then
	fail "python3 lacks tomllib (3.11+); the helpers parse manifests"
fi
# The helpers that carry their own tests, named here so a helper without a selftest is a visible
# gap in this list rather than an invisible gap in a grep.
for f in rust_names spelled_out unit_symbols abbreviations register_names british_spelling service_model contract_names question_shape standalone prose_caps passive_voice history_phrases prose_text prose_acronyms prose_figures readme_documents readme_acronyms inflated_wording readme_sections readme_badges function_length orphan_modules check_links falsify architect-label-rules \
	mutants_gate mutation_plan job_budget workflow_shape kani_bump publish_mode semver_baseline semver_major crate_info settings_members; do
	"$py" "helpers/$f.py" --selftest
done
"$py" script/check-settings --selftest
"$py" script/apply-settings --help >/dev/null && echo "apply-settings --help ok"
echo "ok"

echo "==> a repository of several crates"
# sample-workspace/ is a virtual workspace over a crate that may be published and one that may not;
# sample/ is a repository of one. The release tag, the semver baseline's prefix and the passes over
# an unpublished member come from helpers/crate_info.py, so the two shapes are asked here.
several=sample-workspace/workspace_sample_contract/Cargo.toml
unpublished=sample-workspace/workspace_sample_fixture/Cargo.toml
info="$py helpers/crate_info.py"
[ "$($info tag $several 1.2.3)" = workspace_sample_contract-v1.2.3 ] || fail "a crate of several is not tagged by name"
[ "$($info tag $unpublished 1.2.3)" = workspace_sample_fixture-v1.2.3 ] || fail "the unpublished crate is not tagged by name"
[ "$($info tag sample/Cargo.toml 1.2.3)" = v1.2.3 ] || fail "a crate of one repository lost its plain v tag"
[ "$($info published $several)" = yes ] || fail "the publishable member is not publishable"
[ "$($info published $unpublished || true)" = no ] || fail "publish = false is publishable"
[ "$($info release-target $unpublished || true)" = no ] || fail "an unpublished member of several is a release target"
[ "$($info release-target sample/Cargo.toml)" = yes ] || fail "the only crate of a repository is not a release target"
[ "$($info members sample-workspace/Cargo.toml --release-targets)" = "$several" ] || fail "the workspace's release targets are not the publishable member"
[ "$($info prefix $several)" = workspace_sample_contract/ ] || fail "a member's prefix is not its directory"
[ -z "$($info prefix sample/Cargo.toml)" ] || fail "a crate at its workspace's root has a prefix"
[ "$(sh helpers/crate-slug.sh sample-workspace/workspace_sample_contract/Cargo.toml)" = -sample-workspace-workspace_sample_contract ] || fail "crate-slug does not name the directory"
[ -z "$(sh helpers/crate-slug.sh Cargo.toml)" ] || fail "crate-slug names a crate at the repository root"
"$py" helpers/settings_members.py --selftest >/dev/null
echo "ok"

echo "==> the weekly fuzz job files nothing and fails on a crash"
# Reads the workflow and its caller, then runs the fuzz script against a stand-in cargo.
sh helpers/fuzz-ci-selftest.sh
echo "ok"

echo "==> the naming checks hold the template's own Rust"
# The sample crate and the lint shim are the Rust a caller's check job would judge here; a word
# list change that refuses the template's own fixture fails before any caller sees it.
rs="$(git ls-files 'sample/*.rs' 'helpers/*.rs' 'helpers/**/*.rs')"
# One file per argument is the point.
# shellcheck disable=SC2086
"$py" helpers/spelled_out.py --manifest sample/Cargo.toml $rs
# shellcheck disable=SC2086
"$py" helpers/unit_symbols.py --manifest sample/Cargo.toml $rs
for check in register_names british_spelling service_model contract_names question_shape; do
	# shellcheck disable=SC2086
	"$py" "helpers/$check.py" --manifest sample/Cargo.toml $rs
done
# shellcheck disable=SC2046
"$py" helpers/service_model.py --prose $(git ls-files sample | grep -v 'Cargo[.]lock$')
# The abbreviations check reports and never fails on a finding, so its run here proves only that the
# shipped word lists and tables load and that it reads the fixture; its selftest above holds the rule.
# shellcheck disable=SC2086
report="$("$py" helpers/abbreviations.py --manifest sample/Cargo.toml $rs)" ||
	fail "the abbreviations check could not read its own configuration"
printf '%s\n' "$report" | tail -1
# The README checks report the same way; their runs over the sample prove their lists load and
# that the sample, which shows the canonical shape, has no finding.
for check in readme_acronyms inflated_wording readme_sections; do
	report="$("$py" "helpers/$check.py" --crate-dir sample --ceiling /dev/null/none)" ||
		fail "the $check check could not read its own configuration"
	printf '%s\n' "$report" | tail -1
	printf '%s\n' "$report" | tail -1 | grep -q ': 0 ' || fail "$check reports a finding in the sample"
done
# The scaffold's README is the shape a new crate starts from, so it keeps the order too.
mkdir -p "$fixtures/scaffold-readme"
cp scaffold/README-crate.md "$fixtures/scaffold-readme/README.md"
"$py" helpers/readme_sections.py --crate-dir "$fixtures/scaffold-readme" --ceiling /dev/null/none |
	tail -1 | grep -q ': 0 ' || fail "scaffold/README-crate.md leaves the shared section order"
echo "ok"

echo "==> the badge row gate (README badges)"
# The sample's row points at this repository's selftest workflow, which is what calls check.yml
# and proofs.yml on it. The scaffold's row, with its placeholders filled the way a new repository
# fills them, passes against the scaffold's own caller workflows, so a new repository starts green.
"$py" helpers/readme_badges.py --crate-dir sample --repository nifeos/crate-workflows >/dev/null ||
	fail "the sample's badge row has a finding"
b="$fixtures/badges"
mkdir -p "$b/good"
sed -e 's/<crate>/example_crate/g' -e 's/<rust-version>/1.88/g' scaffold/README-crate.md >"$b/good/README.md"
printf '[package]\nname = "example_crate"\nlicense = "MIT OR Apache-2.0"\nrust-version = "1.88"\n' >"$b/good/Cargo.toml"
badges() {
	dir="$b/$1"
	shift
	"$py" helpers/readme_badges.py --crate-dir "$dir" --repository nifeos/example_crate \
		--workflows-dir scaffold/caller-workflows "$@" >/dev/null 2>&1
}
badges good || fail "the scaffold's badge row, filled in, has a finding"
grep -q '^\[!\[' scaffold/README-crate.md || fail "scaffold/README-crate.md has no badge row"
# Three ways to go red: no row, a link into another repository, a stale minimum Rust version.
for bad in no-row other-repository stale-rust; do
	mkdir -p "$b/$bad"
	cp "$b/good/Cargo.toml" "$b/$bad/"
done
grep -v '^\[!\[' "$b/good/README.md" >"$b/no-row/README.md"
sed 's#nifeos/example_crate/actions/workflows/ci.yml?#other/repository/actions/workflows/ci.yml?#' \
	"$b/good/README.md" >"$b/other-repository/README.md"
sed 's#rust-1.88%2B#rust-1.85%2B#' "$b/good/README.md" >"$b/stale-rust/README.md"
for bad in no-row other-repository stale-rust; do
	badges "$bad" && fail "the badge row gate passed the $bad fixture"
	badges "$bad" --report-only || fail "the badge row gate failed the $bad fixture under --report-only"
done
# The weekly half: the crates.io and docs.rs pair, judged by whether the crate is published.
badges good --published no --published-only || fail "an unpublished crate without the pair fails"
badges good --published yes --published-only && fail "a published crate without the pair passes"
mkdir -p "$b/published"
cp "$b/good/README.md" "$b/good/Cargo.toml" "$b/published/"
badges published --add-published || fail "--add-published failed"
badges published --published yes || fail "--add-published does not satisfy a published crate"
badges published --published no --published-only && fail "an unpublished crate with the pair passes"
echo "ok"

echo "==> typos gate (en-us spelling)"
# The gate must pass a clean tree, fail a misspelling, fail a British spelling, and refuse a
# missing config or another locale. typos is required: without it the check would prove nothing.
command -v typos >/dev/null 2>&1 || fail "typos is not installed (the gate pins typos@1.51.1)"
t="$fixtures/typos"
mkdir -p "$t/clean" "$t/typo" "$t/british" "$t/noconfig" "$t/locale"
for d in clean typo british noconfig locale; do
	cp scaffold/_typos.toml "$t/$d/_typos.toml"
	printf 'The receiver is idle.\n' >"$t/$d/README.md"
done
printf 'The receiver is idle, and we recieve nothing.\n' >"$t/typo/README.md"
printf 'The colour is grey and the buffer is initialised.\n' >"$t/british/README.md"
rm "$t/noconfig/_typos.toml"
printf '[default]\nlocale = "en"\n' >"$t/locale/_typos.toml"
sh helpers/typos_gate.sh "$t/clean" >/dev/null || fail "typos gate refused a clean tree"
for bad in typo british noconfig locale; do
	if sh helpers/typos_gate.sh "$t/$bad" >/dev/null 2>&1; then
		fail "typos gate passed the $bad fixture"
	fi
done
# The fixtures that caller repositories copy, and this repository's own tree, pass.
sh helpers/typos_gate.sh sample >/dev/null || fail "typos gate refused sample/"
sh helpers/typos_gate.sh scaffold >/dev/null || fail "typos gate refused scaffold/, which every crate copies"
sh helpers/typos_gate.sh . >/dev/null || fail "typos gate refused this repository's tree"
for f in scaffold/_typos.toml sample/_typos.toml _typos.toml; do
	grep -Eq '^locale[[:space:]]*=[[:space:]]*"en-us"' "$f" || fail "$f does not set the en-us locale"
done
echo "ok"

echo "==> the scaffold stands alone"
# Everything under scaffold/ is copied into a crate repository, which carries no vocabulary from
# another tree (helpers/scaffold_alone.sh).
# The helper reads whole words, so a bad fixture proves it refuses each one and a good one passes.
a="$fixtures/alone"
mkdir -p "$a/clean" "$a/nife" "$a/calef" "$a/milestone"
for d in clean nife calef milestone; do
	printf 'A crate that stands alone.\n' >"$a/$d/README.md"
done
printf 'Taken from Nife.\n' >"$a/nife/README.md"
printf 'Ask calef.\n' >"$a/calef/README.md"
printf 'See milestone 887.\n' >"$a/milestone/README.md"
sh helpers/scaffold_alone.sh "$a/clean" >/dev/null || fail "scaffold_alone refused a clean tree"
for bad in nife calef milestone; do
	if sh helpers/scaffold_alone.sh "$a/$bad" >/dev/null 2>&1; then
		fail "scaffold_alone passed the $bad fixture"
	fi
done
sh helpers/scaffold_alone.sh scaffold || fail "the scaffold names another tree's vocabulary"
sh helpers/scaffold_alone.sh scaffold-workspace || fail "the callers for several crates name another tree's vocabulary"
echo "ok"

echo "==> actions are pinned to a commit SHA"
unpinned="$(git grep -nE '^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]' -- .github |
	grep -vE 'uses:[[:space:]]+\./' |
	grep -vE 'uses:[[:space:]]+[^@[:space:]]+@[0-9a-f]{40}([[:space:]]|$)' || true)"
[ -z "$unpinned" ] || fail "an action is not pinned to a full SHA:
$unpinned"
echo "ok"

echo "==> workflow shape and budgets"
"$py" helpers/workflow_shape.py
"$py" helpers/job_budget.py lint
echo "ok"

echo "==> release rehearsal and tag-only runs hold no environment"
# A dry run must never ask a person to approve a deployment: only the publish job may name an
# environment, and the rehearse job must exist and run only in a dry run.
"$py" - <<'PY' || fail "release.yml: the rehearsal must run in no environment"
import sys
try:
    import yaml
except ImportError:
    sys.exit(0)
jobs = yaml.safe_load(open(".github/workflows/release.yml"))["jobs"]
with_env = sorted(k for k, v in jobs.items() if "environment" in v)
assert with_env == ["publish"], with_env
assert jobs["rehearse"]["if"].strip("${} ") == "inputs.dry-run", jobs["rehearse"]["if"]
# Tag-only mode: publish runs only when dry-run is false and publish is true, and nothing else
# may depend on it, so a tag-only run cannot reach the crates-io environment.
assert jobs["publish"]["if"].strip("${} ") == "!inputs.dry-run && inputs.publish", jobs["publish"]["if"]
assert jobs["tag"]["if"].strip("${} ") == "!inputs.dry-run", jobs["tag"]["if"]
for k, v in jobs.items():
    needs = v.get("needs", [])
    needs = [needs] if isinstance(needs, str) else needs
    assert "publish" not in needs, k
PY
echo "ok"

echo "==> tracked-but-ignored files"
litter="$(git ls-files -ci --exclude-standard)"
[ -z "$litter" ] || fail "tracked but ignored: $litter"
echo "ok"

echo "==> prose style"
# Octal, not hex: dash's printf does not interpret \xHH, and an ASCII "\xe2\x80\x94" would
# match this very line, which is the failure the first CI run found.
emdash="$(printf '\342\200\224')"
if git grep -n -F "$emdash" -- '*.md' '*.yml' script helpers; then
	fail "an em-dash is in the tree; use commas, periods, semicolons, or parentheses"
fi
if git grep -niE 'delve|comprehensive|landscape|moreover|furthermore|notably|it.s worth noting|straightforward' -- '*.md'; then
	fail "a banned word is in the tree"
fi
[ -f README.md ] || fail "no README"
[ -f CHANGELOG.md ] || fail "no CHANGELOG"
echo "ok"

echo "==> acronyms and banned figures (this repository's prose and the sample's doc comments)"
"$py" helpers/prose_acronyms.py README.md CHANGELOG.md AGENTS.md CONTRIBUTING.md sample/README.md scaffold/*.md scaffold/docs/*.md sample/src/*.rs
"$py" helpers/prose_figures.py README.md CHANGELOG.md AGENTS.md CONTRIBUTING.md sample/README.md scaffold/*.md scaffold/docs/*.md sample/src/*.rs
echo "ok"

echo "==> markdown links resolve"
"$py" helpers/check_links.py
echo "ok"

echo "==> prose caps (this repository's README and CHANGELOG)"
"$py" helpers/prose_caps.py README.md CHANGELOG.md
echo "ok"

echo "==> actionlint (the workflow YAML's own linter)"
# Required, like typos: without it the workflow YAML would be unchecked until CI. The pin lives in
# helpers/install_actionlint.sh, which the selftest workflow also runs.
pinned="$(sh helpers/install_actionlint.sh --version)"
command -v actionlint >/dev/null 2>&1 ||
	fail "actionlint is not installed; run: sh helpers/install_actionlint.sh \"\$HOME/.local/bin\" (linux amd64, pins actionlint $pinned) and put that directory on PATH"
[ "$(actionlint -version | head -1)" = "$pinned" ] ||
	fail "actionlint $(actionlint -version | head -1) is installed but the ignores below are written for $pinned; run: sh helpers/install_actionlint.sh \"\$HOME/.local/bin\""
# Callers' templates carry placeholders (the pin, the mutation cron) that are not valid YAML for
# actionlint; fill them as canary-adopt.yml does, in a scratch tree, so the files a crate
# repository receives are linted too. The workflows of this repository come first.
tpl="$fixtures/callers"
mkdir -p "$tpl/.github/workflows"
for f in scaffold/caller-workflows/*.yml; do
	sed -e 's/@PINS@/@0000000000000000000000000000000000000000/' -e 's/@MUTATION_CRON@/20 8 * * 1/' "$f" >"$tpl/.github/workflows/$(basename "$f")"
done
# The callers for a repository of several crates are linted the same way, in a tree of their own.
mkdir -p "$tpl-several/.github/workflows"
for f in scaffold-workspace/*.yml; do
	sed -e 's/@PINS@/@0000000000000000000000000000000000000000/' -e 's/@MUTATION_CRON@/20 8 * * 1/' "$f" >"$tpl-several/.github/workflows/$(basename "$f")"
done
# EXCEPTION, marked: actionlint 1.7.12's job-context model predates GitHub's
# job.workflow_sha / job.workflow_repository, which the contexts reference documents and which
# the lag check and helper checkout depend on. The two -ignore patterns name exactly those
# properties and nothing else; the selftest's own runs are the proof the properties resolve on
# github.com. A newer actionlint that knows them makes the ignores dead and harmless.
# EXCEPTION, marked: CRATES_IO_FIRST_PUBLISH_TOKEN is an environment secret of the caller's
# crates-io environment, read by release.yml's publish job (which names that environment). It
# cannot be a declared workflow_call secret: a caller job has no environment to pass it from.
# The ignore names that one secret only.
set -- \
	-ignore 'property "crates_io_first_publish_token" is not defined' \
	-ignore 'property "workflow_sha" is not defined' \
	-ignore 'property "workflow_repository" is not defined'
actionlint "$@"
actionlint "$@" "$tpl"/.github/workflows/*.yml "$tpl-several"/.github/workflows/*.yml
echo "ok"

echo "==> lint: ok"
