#!/usr/bin/env python3
"""Read a crate repository's live settings back and fail on any difference.

    script/check-settings <owner/name> [--settings PATH]

The weekly `settings-drift` job runs this against the pinned template's own settings file, so the
comparison is always against the version of the template the caller actually runs. A setting
changed by hand in the web interface is a red run, not a surprise; the run's output names the
setting, the value the file rules, and the value the repository now has.

What this reads: features, merging, metadata, security toggles, the Actions permission set and allowlist (patterns compared
exactly), the `crates-io` environment's reviewers, both rulesets (target, conditions, bypass actors, and every
rule with its parameters), and the label set. What it does not read: team membership and app
installation permissions, which need organization scopes; those drift silently, and this is the BUGS
entry that says so.
"""

import json
import subprocess
import sys
from pathlib import Path

SETTINGS = Path(__file__).resolve().parent.parent / 'settings' / 'repository-settings.json'


def api(*args, method='GET', input_=None):
    cmd = ['gh', 'api', '--method', method, *args]
    run = subprocess.run(cmd, input=json.dumps(input_) if input_ is not None else None,
                         capture_output=True, text=True)
    if run.returncode != 0:
        return None, run.stderr
    try:
        return json.loads(run.stdout), None
    except json.JSONDecodeError:
        return {}, None


def rulesets_unreadable(repo, err):
    """The finding for a ruleset read the token could not make, naming its own fix."""
    if err and ('403' in err or 'Forbidden' in err or 'Must have admin rights' in err):
        return (f'{repo}: reading the rulesets needs repository Administration read-only, which the '
                'GITHUB_TOKEN cannot be granted (GitHub refuses the scope in any permissions block). '
                'Set a SETTINGS_TOKEN secret holding a fine-grained PAT with that scope; an '
                'organization secret covers every crate repository at once.')
    return f'rulesets unreadable: {err}'


def subset_diffs(path, want, got):
    """Every key the file names must read back equal; keys only the live side has are the API's
    defaults and are not drift. Lists compare as given."""
    if isinstance(want, dict):
        if not isinstance(got, dict):
            return [f'{path}: file says {want}, repository has {got}']
        out = []
        for key, value in want.items():
            out += subset_diffs(f'{path}.{key}', value, got.get(key))
        return out
    return [] if want == got else [f'{path}: file says {want}, repository has {got}']


def ruleset_diffs(rs, detail):
    """What differs between one ruleset in the file and its live detail: target, conditions, the
    bypass actors (as a set), and the rules (names and parameters, both directions)."""
    name = f'ruleset "{rs["name"]}"'
    out = []
    if detail.get('target') != rs['target']:
        out.append(f'{name}: target is {detail.get("target")}, file says {rs["target"]}')
    out += subset_diffs(f'{name}: conditions', rs['conditions'], detail.get('conditions') or {})

    def actors(items):
        return {(a.get('actor_id'), a.get('actor_type'), a.get('bypass_mode')) for a in items or []}
    want_actors, got_actors = actors(rs['bypass_actors']), actors(detail.get('bypass_actors'))
    if want_actors != got_actors:
        out.append(f'{name}: bypass actors differ; missing {sorted(want_actors - got_actors, key=str)}, '
                   f'extra {sorted(got_actors - want_actors, key=str)}')

    rules = {r['type']: r.get('parameters') or {} for r in detail.get('rules', [])}
    for rtype in sorted(set(rs['rules']) - set(rules)):
        out.append(f'{name}: rule {rtype} missing')
    for rtype in sorted(set(rules) - set(rs['rules'])):
        out.append(f'{name}: rule {rtype} is on but not in the file')
    for rtype, want_params in rs['rules'].items():
        if rtype not in rules or not isinstance(want_params, dict):
            continue
        got_params = rules[rtype]
        if rtype == 'required_status_checks':
            want_ctx = {c['context'] for c in want_params['required_status_checks']}
            got_ctx = {c['context'] for c in got_params.get('required_status_checks', [])}
            if want_ctx != got_ctx:
                out.append(f'{name}: required checks differ; '
                           f'missing {sorted(want_ctx - got_ctx)}, extra {sorted(got_ctx - want_ctx)}')
            want_params = {k: v for k, v in want_params.items() if k != 'required_status_checks'}
        out += subset_diffs(f'{name}: rule {rtype}', want_params, got_params)
    return out


def main(argv):
    args = argv[1:]
    settings = SETTINGS
    if '--settings' in args:
        i = args.index('--settings')
        settings = Path(args[i + 1])
        args = args[:i] + args[i + 2:]
    if len(args) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    repo = args[0]
    s = json.loads(settings.read_text())
    diffs = []

    live, err = api(f'repos/{repo}')
    if live is None:
        print(f'check-settings: could not read {repo}: {err}', file=sys.stderr)
        return 2
    for key, want in {**s['features'], **s['merging']}.items():
        if live.get(key) != want:
            diffs.append(f'{key}: file says {want}, repository has {live.get(key)}')
    if live.get('homepage') != s['metadata']['homepage'] and s['metadata']['homepage'] != 'https://docs.rs':
        pass  # the homepage is crate-specific; apply-settings fills it from --crate

    ssa = (live.get('security_and_analysis') or {})
    if not ssa:
        diffs.append('security/security_and_analysis: the API returns no block for this token, so '
                     'the four toggles are unverifiable by read here; they were verified at '
                     'apply time, and an organization token would make this row readable')
    else:
        for key, want in (('secret_scanning', s['security']['secret_scanning']),
                          ('secret_scanning_push_protection', s['security']['secret_scanning_push_protection'])):
            status = (ssa.get(key) or {}).get('status')
            got = {'enabled': True, 'disabled': False, None: None}.get(status, status)
            if got != want:
                diffs.append(f'security/{key}: file says {want}, repository has {got}')
        # private_vulnerability_reporting and dependabot_alerts are absent from the read on a
        # public repository (measured): the first is not offered there, the second is always on.
        # Unverifiable by read is not drift, so they are skipped rather than flagged.

    perms, err = api(f'repos/{repo}/actions/permissions')
    if perms is None:
        diffs.append(f'actions/permissions unreadable: {err}')
    else:
        if perms.get('enabled') != s['actions']['enabled'] or \
                perms.get('allowed_actions') != s['actions']['allowed_actions']:
            diffs.append(f"actions: file says {s['actions']['enabled']}/{s['actions']['allowed_actions']}, "
                         f'repository has {perms.get("enabled")}/{perms.get("allowed_actions")}')
    wf, err = api(f'repos/{repo}/actions/permissions/workflow')
    if wf is None:
        diffs.append(f'actions/workflow unreadable: {err}')
    else:
        if wf.get('default_workflow_permissions') != s['actions']['default_workflow_permissions']:
            diffs.append(f"default_workflow_permissions: file says {s['actions']['default_workflow_permissions']}, "
                         f"repository has {wf.get('default_workflow_permissions')}")

    sel, err = api(f'repos/{repo}/actions/permissions/selected-actions')
    if sel is None:
        diffs.append(f'actions allowlist unreadable: {err}')
    else:
        for key in ('github_owned_allowed', 'verified_allowed'):
            if sel.get(key) != s['actions'][key]:
                diffs.append(f"actions {key}: file says {s['actions'][key]}, repository has {sel.get(key)}")
        want_p, got_p = set(s['actions']['patterns_allowed']), set(sel.get('patterns_allowed') or [])
        if want_p != got_p:
            diffs.append(f'actions patterns_allowed differ; missing {sorted(want_p - got_p)}, '
                         f'extra {sorted(got_p - want_p)}')

    env, err = api(f'repos/{repo}/environments/{s["environment"]["name"]}')
    if env is None:
        diffs.append(rulesets_unreadable(repo, f'environment {s["environment"]["name"]}: {err}'))
    else:
        # protection_rules is a list of rule objects; the reviewers ride the one of type
        # required_reviewers (measured live on the exit-test repository).
        got = set()
        for rule in env.get('protection_rules') or []:
            if rule.get('type') == 'required_reviewers':
                got |= {r.get('reviewer', {}).get('login') for r in rule.get('reviewers', [])}
        want = set(s['environment']['reviewers'])
        if got != want:
            diffs.append(f'environment reviewers: file says {sorted(want)}, repository has {sorted(got)}')

    live_rulesets, err = api(f'repos/{repo}/rulesets?per_page=100')
    if live_rulesets is None:
        diffs.append(rulesets_unreadable(repo, err))
    else:
        by_name = {r['name']: r for r in live_rulesets}
        for rs in s['rulesets']:
            got = by_name.get(rs['name'])
            if got is None:
                diffs.append(f'ruleset "{rs["name"]}": missing')
                continue
            if got.get('enforcement') != rs['enforcement']:
                diffs.append(f'ruleset "{rs["name"]}": enforcement is {got.get("enforcement")}')
            detail, err = api(f'repos/{repo}/rulesets/{got["id"]}')
            if detail is None:
                diffs.append(f'ruleset "{rs["name"]}": could not read the detail: {err}')
                continue
            diffs.extend(ruleset_diffs(rs, detail))

    labels, err = api(f'repos/{repo}/labels?per_page=100')
    if labels is None:
        diffs.append(f'labels unreadable: {err}')
    else:
        have = {l['name'] for l in labels}
        for label in s['labels']:
            if label['name'] not in have:
                diffs.append(f'label {label["name"]}: missing')

    if diffs:
        print(f'check-settings: {len(diffs)} difference(s) between the template and {repo}:')
        for d in diffs:
            print(f'  - {d}')
        return 1
    print(f'==> check-settings: {repo} matches the template')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
