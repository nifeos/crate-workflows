#!/bin/sh
# shellcheck shell=sh
#
# script/stranger-due: fail when the stranger run is overdue.
#
#     script/stranger-due [docs/stranger-test.md]
#
# The release's whole claim is that a stranger, given the repository and nothing else, can build
# the crate and run its proofs from the README alone. nife runs that check with a real agent on a
# cadence; a crate repository owes the same ritual, and this job is what makes forgetting red.
# The record is one line in docs/stranger-test.md:
#
#     Last run: 2026-10-15
#
# DUE_DAYS is 28, a month in UTC days. A missing file, or a line naming no date, is overdue: the
# gate fails closed.

set -eu

file="${1:-docs/stranger-test.md}"
due_days="${STRANGER_DUE_DAYS:-28}"

[ -f "$file" ] || {
	echo "stranger-due: no $file. A release claims a stranger can build this crate from the README;"
	echo "stranger-due: record each run's date there ('Last run: YYYY-MM-DD') and do one now."
	exit 1
}

last="$(grep -E '^Last run: [0-9]{4}-[0-9]{2}-[0-9]{2}$' "$file" | tail -1 | cut -d' ' -f3)"
[ -n "$last" ] || {
	echo "stranger-due: $file carries no 'Last run: YYYY-MM-DD' line. The gate fails closed."
	exit 1
}

now="$(date -u '+%s')"
then="$(date -u -j -f '%Y-%m-%d' "$last" '+%s' 2>/dev/null ||
	date -u -d "$last" '+%s' 2>/dev/null)" || then=""
[ -n "$then" ] || {
	echo "stranger-due: could not parse the date $last (want YYYY-MM-DD)."
	exit 1
}

age_days=$(( (now - then) / 86400 ))
if [ "$age_days" -gt "$due_days" ]; then
	echo "stranger-due: the last stranger run was $age_days days ago, past the $due_days-day cadence."
	echo "stranger-due: build the crate and run its proofs from the README alone, then record the date."
	exit 1
fi
echo "==> stranger-due: the last stranger run was $age_days days ago, within the ${due_days}-day cadence"
